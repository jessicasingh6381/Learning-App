APP_ENV=migration
APP_KEY=
APP_DEBUG=false

# Read-only access is strongly recommended for the source account.
MIGRATION_SOURCE_HOST=127.0.0.1
MIGRATION_SOURCE_PORT=3306
MIGRATION_SOURCE_DATABASE=learning_app
MIGRATION_SOURCE_USERNAME=
MIGRATION_SOURCE_PASSWORD=

# Never commit real Azure credentials. Only explicitly allowlisted names work.
MIGRATION_TARGET_HOST=cosmic-academy-pg.postgres.database.azure.com
MIGRATION_TARGET_PORT=5432
MIGRATION_TARGET_DATABASE=cosmic_academy
MIGRATION_TARGET_USERNAME=
MIGRATION_TARGET_PASSWORD=
MIGRATION_TARGET_SSLMODE=require
ACADEMY_MIGRATION_APPROVED_TARGETS=cosmic_academy
ACADEMY_MIGRATION_APPROVED_TARGET_HOSTS=cosmic-academy-pg.postgres.database.azure.com

LOG_CHANNEL=single
